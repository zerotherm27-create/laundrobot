# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/laundrobot

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Xendit ────────────────────────────────────────────────────────────────────
XENDIT_CALLBACK_TOKEN=
XENDIT_PLATFORM_API_KEY=

# ── Facebook Messenger ────────────────────────────────────────────────────────
FB_PAGE_ACCESS_TOKEN=
FB_VERIFY_TOKEN=
FB_APP_SECRET=

# ── Email ─────────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
PLATFORM_NOTIFY_EMAIL=

# ── Push notifications ────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=

# ── TLP POS integration ───────────────────────────────────────────────────────
# Set both to enable real-time order dispatch to TLP POS after payment confirmation.
# TLP_POS_IMPORT_TOKEN must match LAUNDROBOT_IMPORT_TOKEN in the TLP POS .env.
TLP_POS_IMPORT_URL=https://your-tlp-pos.vercel.app/api/orders/import
TLP_POS_IMPORT_TOKEN=
# Optional: the address staff are taken to by "Open LaundroDesk?" (defaults to the origin of TLP_POS_IMPORT_URL).
LAUNDRODESK_APP_URL=
